# BuildWise Production Environment Configuration
# For Vercel (Frontend) + Railway (Backend) Deployment
# 
# Instructions:
# 1. BACKEND (.env on Railway): Set all variables below
# 2. FRONTEND (.env on Vercel): Only set VITE_API_URL
# DO NOT COMMIT THIS FILE - Use Railway/Vercel dashboards for actual secrets

# ============================================================================
# BACKEND ONLY - Railway Environment Variables
# ============================================================================

# Database Configuration (PROVIDED BY RAILWAY - copy from PostgreSQL box)
DATABASE_URL=postgresql://postgres:your_password@containers-us-west-123.railway.app:7932/railway

# JWT Secret Key (GENERATE NEW: openssl rand -hex 32)
# Must be 32+ characters and unique per deployment
SECRET_KEY=your_32_char_hex_string_here_min_length_is_32_chars

# AI Service API Keys
GROQ_API_KEY=gsk_your_groq_key_from_console
HUGGINGFACE_API_KEY=hf_your_huggingface_token

# OAuth - GitHub (Get from GitHub Developer Settings)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# OAuth - Google (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-railway-backend.railway.app/auth/google/callback

# Payment Gateway - Razorpay (Get from Razorpay Dashboard)
# Use TEST keys for prototype, PRODUCTION keys for real transactions
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Service (Gmail + App Password)
# Important: Use Gmail App Password, NOT your main Gmail password
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your_gmail_app_specific_password

# Application URLs (SET AFTER DEPLOYMENT)
# Frontend URL - Vercel deployment address
FRONTEND_URL=https://buildwise-frontend.vercel.app

# Backend URL - Railway deployment address  
BACKEND_URL=https://your-railway-backend.railway.app

# ============================================================================
# FRONTEND ONLY - Vercel Environment Variable
# ============================================================================

VITE_API_URL=https://your-railway-backend.railway.app

# ============================================================================
# LOCAL DEVELOPMENT (for reference - use .env file locally)
# ============================================================================

# For local testing before deployment:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=buildwise_db
# DB_USER=postgres
# DB_PASSWORD=your_local_postgres_password
# FRONTEND_URL_DEV=http://localhost:5173
# BACKEND_URL_DEV=http://localhost:8000

# ============================================================================
# DEPLOYMENT CHECKLIST
# ============================================================================
# Before going live, verify:
# [ ] All DATABASE_URL set correctly (Railway PostgreSQL)
# [ ] SECRET_KEY generated and saved safely (never share this)
# [ ] GROQ_API_KEY and HUGGINGFACE_API_KEY set
# [ ] GitHub OAuth credentials configured
# [ ] Google OAuth credentials configured with redirect URI
# [ ] Razorpay keys set (test or production)
# [ ] Email credentials work (test with password reset)
# [ ] FRONTEND_URL points to Vercel deployment
# [ ] BACKEND_URL points to Railway deployment
# [ ] VITE_API_URL on Vercel matches BACKEND_URL

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
# 1. NEVER commit .env files to Git
# 2. NEVER share SECRET_KEY or credentials in messages/code
# 3. Use environment dashboard (Railway/Vercel) to manage secrets
# 4. Rotate secrets periodically in production
# 5. Use different keys for test vs production (Razorpay)
# 6. Gmail App Passwords expire - monitor for "Authentication failed" errors
# 7. Log out of old sessions after deployment
